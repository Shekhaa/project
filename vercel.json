{
  "buildCommand": "cd mobile && npm install && npx expo export -p web",
  "outputDirectory": "mobile/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://campus-connect-api-us3i.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://campus-connect-api-us3i.onrender.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
