# ========================================================
# CAMPUS CONNECT ENVIRONMENT CONFIGURATION
# ========================================================

# Secret Key (Set for production)
SECRET_KEY=django-insecure-campus-connect-production-ready-secret-key-2026
DEBUG=True

# ========================================================
# REAL SMS GATEWAY (Choose either Fast2SMS or Twilio)
# ========================================================

# 1. Fast2SMS (Recommended for India +91 mobile numbers)
# Sign up at https://www.fast2sms.com -> Dev API -> Copy API Key (Free credits available)
FAST2SMS_API_KEY=

# 2. Twilio (Alternative for International / Indian SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================================
# EMAIL CONFIGURATION (Optional - for real Gmail SMTP)
# ========================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
